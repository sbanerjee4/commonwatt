# Amazon Bedrock auth — copy this file to .env and fill in your key.
# .env is git-ignored; NEVER commit real credentials.

# Bedrock API key (bearer token) generated in the Bedrock console.
# Begins with "bedrock-api-key-..."
AWS_BEARER_TOKEN_BEDROCK=

# AWS region where you enabled Claude model access.
AWS_REGION=us-east-1

# Optional: override the Claude model id if a different one is enabled.
# COMMONWATT_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0

# --- Browser push (optional, free). Generate a VAPID key pair once. ---
# Leave blank to disable push; the app degrades cleanly without it.
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_CLAIM_EMAIL=you@example.com
