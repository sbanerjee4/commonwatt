# CommonWatt SMS config. Copy to `.env` and fill in. NEVER commit `.env`.

# Which provider send_sms uses: "simulated" (default, no network) or "twilio".
SMS_PROVIDER=simulated

# Demo guard for the Twilio provider. Keep true until you trust the flow:
# real Twilio sends, but ONLY to numbers in the allowlist below.
SMS_DEMO_MODE=true
SMS_DEMO_ALLOWLIST=+15551234567

# Twilio credentials (only needed when SMS_PROVIDER=twilio).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+15550001111

# --- Browser push (optional, free). Generate a VAPID key pair once. ---
# Leave blank to disable push; the app degrades cleanly without it.
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_CLAIM_EMAIL=you@example.com
